# Twitter API Configuration
# Optional. When no bearer tokens are set, the API automatically serves shared
# demo tweets from the demo_tweets collection instead of calling Twitter.
TWITTER_BEARER_TOKEN_1=your_twitter_bearer_token_here
TWITTER_BEARER_TOKEN_2=your_second_twitter_bearer_token_here

# Demo tweets
# Force demo tweets even when Twitter credentials are configured.
USE_DEMO_TWEETS=true

# Database
MONGODB_URI=mongodb://localhost:27017/tweetwatch

# Python ML Service Configuration
PYTHON_ML_SERVICE_URL=http://localhost:8000

# Server Configuration
PORT=3001
NODE_ENV=development

# Auth Configuration
# Required in production. In development the server falls back to a local secret.
JWT_SECRET=replace_with_a_long_random_string